# Copy this file to `.env` and fill in what you need:  cp .env.example .env
# It must sit NEXT TO pyproject.toml, i.e. in this multimodal_llms folder.
#
# Which provider each project uses is ONE line at the top of its chatbot.py:
#     ai = use("openrouter")      # openrouter | google | ollama
# Base URLs and model names are in config.py. This file holds only secrets.

# --- For use("openrouter") --- projects 1-7. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- For use("google") --- projects 1, 4, 6, 7. https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# --- For use("ollama") --- no key needed at all. Just:  ollama pull gemma4:e2b

# --- Project 7 only: Google Workspace OAuth (NOT the same as GOOGLE_API_KEY) ---
# A Desktop-app OAuth client from console.cloud.google.com with the Gmail and
# Calendar APIs enabled, and your own address added as a Test user.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
USER_GOOGLE_EMAIL=
